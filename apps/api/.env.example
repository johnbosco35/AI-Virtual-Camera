# Placeholders only. Never commit real secrets.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/avc
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Admin auth (min 32 chars each). Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-value-at-least-32-chars
ADMIN_JWT_TTL_SECONDS=900
# Derives activation codes, challenge MACs, and download tokens. Rotating it invalidates issued codes.
SERVER_SECRET=replace-with-another-long-random-value-32-chars

# Payments: TRON USDT (TRC-20) only.
# Use nile or shasta for testing. mainnet is real money.
TRON_NETWORK=nile
TRON_API_KEY=
# Required for nile/shasta (test token contract). Optional for mainnet (official USDT is the default).
TRON_USDT_CONTRACT=
# Receive-only address. Never put a private key on this server.
PAYMENT_DESTINATION_ADDRESS=
ORDER_TTL_MINUTES=30

# Releases / downloads
RELEASE_STORAGE_DIR=./releases
DOWNLOAD_TOKEN_TTL_SECONDS=300

# Jobs
JOBS_ENABLED=true
LOG_LEVEL=info

# Seed script
PRODUCT_PRICE_USDT=25.00
